{
  "name": "@banh-me/pi-model-costs",
  "version": "0.1.0",
  "description": "Per-1M-token model pricing in Pi's model picker. Overrides the built-in /model selector (or installs as a separate /model-costs command) and includes custom providers.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "models",
    "pricing",
    "cost",
    "tokens"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banh-me/pi-model-costs.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/banh-me/pi-model-costs/issues"
  },
  "homepage": "https://github.com/banh-me/pi-model-costs#readme",
  "files": [
    "extension/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "author": "banh-me",
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
